# ── Airtable ────────────────────────────────────────────────────────────────
# Personal access token. Scopes: data.records:read, data.records:write, schema.bases:read, webhook:manage
# Restrict it to the Foundry base only (for A&S: "Admin Sync Test").
AIRTABLE_PAT=
# The base ID, from the base URL (starts with app…)
AIRTABLE_BASE_ID=

# ── Local demo ──────────────────────────────────────────────────────────────
# Demo mode: enables the persona switcher. Loopback only, never in a deployment, and the
# process refuses to start if it is set together with OIDC_ISSUER.
FOUNDRY_DEMO=1
HOST=127.0.0.1

# Optional. Enables Ask Foundry on Claude; without it the chat uses keyword search.
ANTHROPIC_API_KEY=
# Optional. Minutes between scheduled full syncs while the app runs (0 disables). Local only:
# on Vercel the crons in vercel.json are the clock.
SYNC_INTERVAL_MINUTES=15
# Optional. Which client config to load: clients/<slug>/foundry.config.ts. Unset = the root file.
FOUNDRY_CLIENT=

# ── Deployment: storage ─────────────────────────────────────────────────────
# Set by the Vercel Blob integration. Present → snapshot, schema and webhook state live in
# Blob instead of data/. Unset → today's files on disk.
BLOB_READ_WRITE_TOKEN=
# Set by the Vercel Marketplace Redis integration (rediss://…). Holds conversations, rate
# limits and the sync lock. Without it (and without the Upstash pair below) those are
# process-local, which is correct on a laptop and wrong on Vercel.
REDIS_URL=
# Alternative to REDIS_URL, if you use Upstash's REST API directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Deployment: jobs ────────────────────────────────────────────────────────
# Required on Vercel. Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` to
# /api/jobs/sync and /api/jobs/drain; without it those routes answer 401 to everyone.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Optional. From `npm run webhook -- create --url https://host/api/webhooks/airtable`.
# When both are set they win over stored webhook state, so a fresh deploy drains the right hook.
AIRTABLE_WEBHOOK_ID=
AIRTABLE_WEBHOOK_SECRET=

# ── Deployment: sign-in (OIDC) ──────────────────────────────────────────────
# Setting OIDC_ISSUER switches Foundry to real sign-in: the verified email is matched to a
# row in the synced Users table, and that row is the session.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. Defaults to "openid email profile".
OIDC_SCOPE=
# The public origin of this deployment. The redirect URI is ${APP_URL}/auth/callback —
# register exactly that with the provider.
APP_URL=
# Signs the session cookie (HMAC-SHA256). At least 32 random characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Set to 1 to let external accounts (outside the org's email domains) sign in.
AUTH_ALLOW_EXTERNAL=
