# Airtable personal access token, scopes: data.records:read, data.records:write, schema.bases:read
# restricted to the Foundry base (for A&S: "Admin Sync Test")
AIRTABLE_PAT=
# The base ID (starts with app…)
AIRTABLE_BASE_ID=
# Demo mode: enables the persona switcher. Never set in a deployed instance.
FOUNDRY_DEMO=1
HOST=127.0.0.1
# Background refresh: full sync interval in minutes (0 disables; default 15)
SYNC_INTERVAL_MINUTES=15
# Webhook payload poll interval in seconds (default 30; used when data/webhook.json exists)
WEBHOOK_POLL_SECONDS=30
# For npm run webhook -- create, the PAT also needs the webhook:manage scope.
