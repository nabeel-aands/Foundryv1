# Airtable personal access token. Scopes: data.records:read, data.records:write, schema.bases:read, webhook:manage
# Restrict it to the Foundry base only (for A&S: "Admin Sync Test").
AIRTABLE_PAT=
# The base ID, from the base URL (starts with app…)
AIRTABLE_BASE_ID=
# Demo mode: enables the persona switcher. Never set this in a deployed instance.
FOUNDRY_DEMO=1
HOST=127.0.0.1
# Optional. Enables Ask Foundry on Claude; without it the chat uses keyword search.
ANTHROPIC_API_KEY=
# Optional. Minutes between scheduled full syncs while the app runs (0 disables).
SYNC_INTERVAL_MINUTES=15
